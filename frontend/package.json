{
  "name": "my-music-vault-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/check-vercel-env.mjs && npm run build",
