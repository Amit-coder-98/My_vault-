VAULT_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017
# For Atlas replace the line above with the URI from Atlas > Connect > Drivers.
# Example: mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=my_music_vault
# Set a random 32+ character secret in production. Development generates a local secret file.
AUTH_SECRET=
FRONTEND_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
COOKIE_SECURE=false
SOURCE_DIR=../Songs_data
STORAGE_DIR=./storage
# Change to b2 after filling all B2 values below. STORAGE_DIR remains temporary processing space.
STORAGE_BACKEND=local
# S3 endpoint from your B2 bucket, for example https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT_URL=
# Must match the endpoint, for example us-west-004.
B2_REGION=
B2_BUCKET_NAME=
# Use a bucket-scoped read/write application key, not the master account key.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PREFIX=Songs_data
MAX_UPLOAD_MB=100
FFMPEG_PATH=ffmpeg
