# Copy to backend/.env.production for the Docker deployment. Keep .env for local development.
VAULT_ENV=production
COOKIE_SECURE=true
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
FRONTEND_URL=https://vault.example.com
ALLOWED_ORIGINS=["https://vault.example.com"]
# Use your existing Atlas database and credentials; URL-encode the password.
MONGODB_URL=
DATABASE_NAME=my_music_vault
STORAGE_BACKEND=b2
B2_ENDPOINT_URL=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PREFIX=Songs_data
STORAGE_DIR=/data
SOURCE_DIR=/imports
MAX_UPLOAD_MB=100
FFMPEG_PATH=ffmpeg
